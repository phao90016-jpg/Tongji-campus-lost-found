@startuml usecase-v03
title v0.3 核心用例 · 相似物品与报表导出
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F3F8F2
  BorderColor #3F6B3A
}
left to right direction


actor "学生" as STU
actor "系统管理员" as ADMIN

rectangle "校园失物招领与认领审核系统 · v0.3" {
  usecase "UC-13 查看相似物品推荐" as UC13
  usecase "UC-31 导出统计报表" as UC31
}

STU -- UC13
ADMIN -- UC31
@enduml
