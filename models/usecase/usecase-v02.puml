@startuml usecase-v02
title v0.2 核心用例 · 治理、通知与工作台
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFF7F0
  BorderColor #A65E2E
}
left to right direction


actor "学生／拾取者" as STU
actor "值班老师" as REVIEWER
actor "系统管理员" as ADMIN
actor "定时任务" as SCHED <<系统角色>>
actor "微信服务号" as WX <<外部系统>>
actor "邮件 SMTP" as MAIL <<外部系统>>

rectangle "校园失物招领与认领审核系统 · v0.2" {
  usecase "UC-14 订阅关键词并接收提醒" as UC14
  usecase "UC-22 举报违规或冒领\n含已关闭招领的举报窗口" as UC22
  usecase "UC-23 处置举报" as UC23
  usecase "UC-25 提交申诉" as UC25
  usecase "UC-27 绑定通知渠道" as UC27
  usecase "UC-28 投递通知与失败降级" as UC28
  usecase "UC-30 查看管理统计看板" as UC30
  usecase "UC-32 查看完整审核队列" as UC32
}

STU -- UC14
STU -- UC22
STU -- UC25
STU -- UC27
REVIEWER -- UC23
REVIEWER -- UC30
REVIEWER -- UC32
ADMIN -- UC30
SCHED -- UC28
UC28 -- WX
UC28 -- MAIL
@enduml
