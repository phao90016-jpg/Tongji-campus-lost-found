@startuml usecase-v01
title v0.1 核心用例 · 招领、认领与交接
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F3F8FC
  BorderColor #2C5F8A
}
left to right direction


actor "失主" as STU
actor "拾取者／保管方" as FINDER
actor "值班老师" as REVIEWER
actor "学生志愿者" as VOL
actor "定时任务" as SCHED <<系统角色>>
actor "对象存储" as OSS <<外部系统>>

rectangle "校园失物招领与认领审核系统 · v0.1" {
  usecase "UC-06 发布招领并设核验题" as UC06
  usecase "UC-11 关键词检索与筛选" as UC11
  usecase "UC-15 提交认领申请" as UC15
  usecase "UC-17 拾取者初审认领" as UC17
  usecase "UC-18 老师终审认领" as UC18
  usecase "UC-19 领取人确认交接" as UC19
  usecase "UC-21 公示截止与自动关闭" as UC21
  usecase "UC-32 跟进值班待办" as UC32
}

STU -- UC11
STU -- UC15
STU -- UC19 : 验物后确认
FINDER -- UC06
FINDER -- UC17 : 给出建议
FINDER -- UC19 : 交付、查看进度
REVIEWER -- UC18
REVIEWER -- UC32 : 超时接手
VOL -- UC32 : 分派后的催办
SCHED -- UC21
SCHED -- UC32 : 生成超时待办
UC18 -- OSS : 取授权证据
@enduml
