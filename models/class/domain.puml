@startuml domain
' ============================================================
' 校园失物招领与认领审核系统 · 领域类图
' 主业务实体见 docs/03-设计.md。
' 旧版 29 个分析类的说明保存在 archive/original-docs-2026-11-27.zip。
' ============================================================
title 领域类图（29 个分析类）

skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #2C5F8A
  ArrowColor #2C5F8A
}

package "身份与权限" {
  class User {
    id
    student_no
    name
    department
    credit_score
    auth_source
    + permissions() : Set[str]
    + canPublishFound() : bool
    + canClaim() : bool
  }
  class Role {
    code
    name
  }
  class Permission {
    code
    description
  }
  class UserRole {
    granted_by
    granted_at
    status
  }
  class FinderCertification {
    contact_phone
    handover_locations
    statement
    status
    review_comment
  }
}

package "物品与发布" {
  class Category {
    code
    name
    sort
    enabled
  }
  class Location {
    campus
    building
    floor
    alias
  }
  class LostItem {
    title
    description
    happened_at
    status
    version
  }
  class FoundItem {
    title
    description
    happened_at
    handover_location
    storage_note
    status
    version
    + canBeClaimed() : bool
  }
  class ItemImage {
    original_key
    masked_key
    status
  }
  class ItemFeature {
    color
    brand
    marks
  }
  class SensitiveMask {
    rule_type
    hit_text
    masked_text
  }
}

package "认领与审核" {
  class ClaimApplication {
    reason
    materials
    expected_handover_at
    status
    version
    reject_reason_code
    + canWithdraw() : bool
  }
  class VerificationQuestion {
    question
    answer_hash
    answer_cipher
    + verify(answer) : bool
  }
  class "ClaimAnswer" as ClaimAnswer <<实现明细>> {
    answer
    is_correct
  }
  class ReviewRecord {
    stage
    decision
    reason_code
    comment
  }
  class HandoverConfirmation {
    claim_id
    item_id
    confirmed_by
    confirmed_at
  }
  class ItemStatusLog {
    target_type
    from_status
    to_status
    reason
  }
}

package "治理" {
  class Report {
    target_type
    target_id
    type
    description
    status
  }
  class ReportDisposition {
    action
    reason
    comment
    appeal_status
  }
  class CreditScore {
    balance
    delta
    reason
  }
  class Appeal {
    materials
    status
    conclusion
  }
}

package "支撑" {
  class Notification {
    type
    title
    body
    read_at
  }
  class NotifyChannel {
    type
    credential_ref
    verified_at
    enabled
  }
  class DeliveryLog {
    channel
    result
    latency_ms
  }
  class KeywordSubscription {
    keyword
    filters
    last_notified_at
  }
  class Favorite {
    note
  }
  class AuditLog {
    action
    target_type
    target_id
    detail
  }
  class StatMetric {
    code
    period
    dimension
    value
  }
  class SystemConfig {
    key
    value
    description
  }
}

' ---------- 身份与权限 ----------
User "1" -- "0..*" UserRole
Role "1" -- "0..*" UserRole
Role "1" -- "0..*" Permission : 包含 >
User "1" -- "0..1" FinderCertification

' ---------- 发布 ----------
User "1" -- "0..*" LostItem : 发布
User "1" -- "0..*" FoundItem : 发布
Category "1" -- "0..*" LostItem
Category "1" -- "0..*" FoundItem
Location "1" -- "0..*" LostItem
Location "1" -- "0..*" FoundItem
LostItem "1" *-- "0..1" ItemFeature
FoundItem "1" *-- "0..1" ItemFeature
LostItem "1" -- "0..5" ItemImage
FoundItem "1" -- "0..5" ItemImage
SensitiveMask ..> LostItem : 校验/遮蔽
SensitiveMask ..> FoundItem : 校验/遮蔽

' ---------- 认领与审核 ----------
FoundItem "1" -- "1..3" VerificationQuestion
FoundItem "1" -- "0..*" ClaimApplication : 收到
User "1" -- "0..*" ClaimApplication : 提交
ClaimApplication "1" *-- "0..3" ClaimAnswer
VerificationQuestion "1" -- "0..*" ClaimAnswer
ClaimApplication "1" -- "0..2" ReviewRecord : 初审/终审
ClaimApplication "1" -- "0..1" HandoverConfirmation
LostItem ..> FoundItem : 相似匹配
ItemStatusLog ..> LostItem : 记录迁移
ItemStatusLog ..> FoundItem : 记录迁移
ItemStatusLog ..> ClaimApplication : 记录迁移

' ---------- 治理 ----------
User "1" -- "0..*" Report : 举报
Report "1" -- "0..1" ReportDisposition
ReportDisposition "1" -- "0..1" Appeal
ReportDisposition ..> CreditScore : 触发扣分
User "1" -- "0..*" CreditScore : 流水

' ---------- 支撑 ----------
User "1" -- "0..*" Notification
Notification "1" -- "0..*" DeliveryLog : 每次尝试
NotifyChannel "1" -- "0..*" DeliveryLog
User "1" -- "0..*" NotifyChannel
User "1" -- "0..*" KeywordSubscription
User "1" -- "0..*" Favorite
Favorite "*" -- "1" FoundItem
User "1" -- "0..*" AuditLog
StatMetric ..> FoundItem : 聚合
SystemConfig ..> User : 阈值

note bottom of ClaimApplication
  **核心不变量**：同一 FoundItem 在同一时刻
  最多 1 条进行中申请
  （数据库部分唯一索引 uq_claim_active 保证）
end note

note bottom of HandoverConfirmation
  仅获准领取人可确认，一案一条。
  重复确认返回原记录。
end note

@enduml
