@startuml sd04-notify-fallback
title SD-04 通知投递与失败降级
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
hide footbox
skinparam sequence {
  ArrowColor #285D49
  LifeLineBorderColor #8CA69A
  ParticipantBackgroundColor #F3F8F4
  ParticipantBorderColor #285D49
}


participant "业务服务" as BIZ
database "数据库" as DB
participant "通知调度" as TICK
participant "微信适配器" as WX
participant "邮件适配器" as MAIL

BIZ -> DB : 与业务一起写入站内消息
opt v0.2 且已绑定外部通道
  BIZ -> DB : 登记待投递任务
end
note right of DB
  用户登录后可查站内消息。
  外部通道的结果不影响站内记录。
end note

opt 有外部投递任务
  TICK -> DB : 条件更新抢占待投递任务
  opt 已绑定微信
    TICK -> WX : 投递微信
    WX --> TICK : 成功或失败
    TICK -> DB : 记录微信结果
  end
  alt 微信成功
    TICK -> DB : 跳过邮件
  else 微信失败或未绑定
    opt 已绑定邮件
      TICK -> MAIL : 改投邮件
      MAIL --> TICK : 成功或失败
      TICK -> DB : 记录邮件结果
    end
  end
end

opt 进程重启
  TICK -> DB : 补扫中断任务，跳过已有成功记录
  note right of DB
    抢占防止本地并发执行同一任务。
    远端已收到但本地未记账的场景需单独验证。
  end note
end
@enduml
