@startuml act-uc15-submit-claim
' ============================================================
' UC-15 提交认领申请 · 活动图
' 对应 SRS §4.2
' ============================================================
title UC-15 提交认领申请

skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam activity {
  BackgroundColor #F7FBFF
  BorderColor #2C5F8A
  DiamondBackgroundColor #FFFFFF
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #C9A227
}

start

:在招领详情页点击「申请认领」;
:系统展示核验问题（不展示答案）;
:填写认领理由、核验答案、补充材料、期望交接时间;

if (目标发布状态 = 公示中 ?) then (否)
  :拒绝：该物品已有认领在审核中;
  stop
else (是)
endif

if (信用分 >= 40 ?) then (否)
  :拒绝：信用分不足;
  :给出申诉入口;
  stop
else (是)
endif

if (目标是本人发布 ?) then (是)
  :拒绝（BR-06-2）;
  stop
else (否)
endif

:事务内 INSERT 申请（pending_first）;

if (唯一索引冲突 uq_claim_active ?) then (是)
  :回滚;
  :返回 409 CLAIM_CONFLICT;
  :提示"已有申请提交成功";
  stop
else (否)
endif

:写状态日志;
:通知拾取者（站内必达 + 通道投递）;
if (通知发送失败 ?) then (是)
  :记录投递失败;
  :降级到站内消息;
  note right : 不阻塞申请提交
else (否)
endif

:返回申请详情与后续流程说明;
stop

@enduml
