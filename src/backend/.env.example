# 复制为 .env 后填写。.env 已加入 .gitignore，不得提交。
# 密钥与真实学工号/手机号严禁进入提示词。

APP_ENV=dev
DATABASE_URL=sqlite:///./var/app.db

# 会话签名密钥（生产必须替换为随机值）
SECRET_KEY=dev-only-change-me
TOKEN_TTL_HOURS=8

# 认证适配器：local（演示兜底） / sso（学校统一身份认证）
AUTH_PROVIDER=local
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback

# 对象存储：local（本地磁盘） / s3（MinIO 或云 OSS）
STORAGE_PROVIDER=local
STORAGE_DIR=./var/objects
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 通知通道：console（打印到日志） / wechat / smtp
NOTIFY_PROVIDER=console
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 业务参数（也可在后台 system_config 中改）
ITEM_EXPIRE_DAYS=60
HANDOVER_TTL_HOURS=72
CLAIM_SLA_HOURS=24
CLAIM_OVERDUE_HOURS=48
RETENTION_DAYS=180
